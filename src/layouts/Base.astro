---
import Signature from '../components/Signature.astro';
import { AUTHOR, CHANNELS, NAV, TAGLINE } from '../data/site';
import { preloadFonts, tokenCss } from '../lib/tokens';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  /** The page opens on a deep band, so the header sits on it in pearl. */
  deep?: boolean;
}

const { title, description, deep = false } = Astro.props;
const year = new Date().getFullYear();
const here = Astro.url.pathname;
const nav = NAV.map((item) => ({ ...item, current: here.startsWith(item.href) }));
const github = CHANNELS.find((c) => c.label === 'GitHub');
const canonical = new URL(here, Astro.site);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <style is:global set:html={tokenCss}></style>
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.dataset.theme = 'dark';
        }
      } catch {}
      try {
        if (!sessionStorage.getItem('signed')) {
          document.documentElement.classList.add('sig-write');
          sessionStorage.setItem('signed', '1');
        }
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class:list={['site-header', { 'site-header--deep': deep }]}>
      <div class="wrap bar">
        <a class="brand" href="/" aria-label={`${AUTHOR}, home`}>
          <Signature swash write />
        </a>
        <nav class="nav" id="site-nav" aria-label="Main">
          <ul>
            {
              nav.map(({ href, label, current }, n) => (
                <li style={`--i:${n}`}>
                  <a href={href} aria-current={current ? 'page' : undefined}>
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="bar-tools">
          <button class="icon-button" type="button" id="theme" aria-label="Switch to dark mode">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.3" />
              <path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor" />
            </svg>
          </button>
          <button
            class="menu-button"
            type="button"
            id="menu"
            aria-expanded="false"
            aria-controls="site-nav"
          >
            <span class="menu-lines" aria-hidden="true"></span>
            <span class="menu-label">Menu</span>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div class="footer-mark">
          <p class="footer-brand"><Signature swash /></p>
          <p class="footer-tagline">{TAGLINE}</p>
        </div>
        <nav aria-label="Footer">
          <ul class="footer-links">
            <li><a href="/">Home</a></li>
            {NAV.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
          </ul>
        </nav>
        <div class="footer-meta">
          {github?.href && (
            <p>
              <a href={github.href}>GitHub</a>
            </p>
          )}
          <p>Set in Libre Bodoni and Jost, signed in Allura.</p>
          <p>© {year} {AUTHOR}</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const theme = document.getElementById('theme');
        const label = () =>
          theme.setAttribute(
            'aria-label',
            root.dataset.theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode',
          );
        label();
        const flip = () => {
          if (root.dataset.theme === 'dark') delete root.dataset.theme;
          else root.dataset.theme = 'dark';
          label();
          try {
            localStorage.setItem('theme', root.dataset.theme || 'light');
          } catch {}
        };
        theme.addEventListener('click', () => {
          const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!document.startViewTransition || still) return flip();
          // The new theme spreads out from the button as a widening circle.
          const box = theme.getBoundingClientRect();
          const x = box.left + box.width / 2;
          const y = box.top + box.height / 2;
          const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
          root.classList.add('theme-switching');
          const t = document.startViewTransition(flip);
          t.ready.then(() =>
            root.animate(
              { clipPath: [`circle(0 at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`] },
              {
                duration: 650,
                easing: 'cubic-bezier(.2,.7,.2,1)',
                pseudoElement: '::view-transition-new(root)',
              },
            ),
          );
          t.finished.finally(() => root.classList.remove('theme-switching'));
        });

        const menu = document.getElementById('menu');
        const setMenu = (open) => {
          menu.setAttribute('aria-expanded', String(open));
          document.body.classList.toggle('menu-open', open);
        };
        menu.addEventListener('click', () =>
          setMenu(menu.getAttribute('aria-expanded') !== 'true'),
        );
        addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && document.body.classList.contains('menu-open')) {
            setMenu(false);
            menu.focus();
          }
        });
        matchMedia('(min-width: 60rem)').addEventListener('change', () => setMenu(false));
      })();
    </script>
  </body>
</html>
