---
import Base from '../../layouts/Base.astro';
import { href, plainSummary, projectPages } from '../../lib/content';

const work = projectPages();
---

<Base
  title="Projects · Tung Anh Tran"
  description="Competition and side-project write-ups by Tung Anh Tran, from 3D CNNs on Parkinson's brain scans to a reading tracker, with methods and results."
>
  <header class="wrap page-head">
    <h1 class="page-title">Projects</h1>
    <p class="page-lede">
      Competitions, side projects and tools for my own use, each written up with what I
      built, how I checked it and what I took away.
    </p>
  </header>

  <div class="wrap">
    <ul class="index-list">
      {
        work.map(({ entry, page }) => (
          <li class="index-item">
            <div>
              <p class="kind">{page.eyebrow.split(' · ').join(', ')}</p>
              <h2 class="index-title">
                <a href={href(entry)}>{page.title}</a>
              </h2>
              <p class="index-text" set:html={plainSummary(page.summary_html)} />
              <ul class="tags">
                {page.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </div>
            {page.stats[0] && (
              <div class="index-stat">
                <p class="index-stat-v">{page.stats[0].value}</p>
                <p class="index-stat-l">{page.stats[0].label}</p>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </div>
  <div class="wrap page-gap"></div>
</Base>
