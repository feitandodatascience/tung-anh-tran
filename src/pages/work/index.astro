---
import Placeholder from '../../components/Placeholder.astro';
import Base from '../../layouts/Base.astro';
import { EDUCATION, EXPERIENCE } from '../../data/site';
import { cv, cvSection } from '../../lib/content';

// Everything below comes from the CV when the export has one; the placeholders in
// data/site.ts only stand in until then.
const data = cv();
const roles = cvSection('experience')?.entries;
const study = cvSection('education')?.entries;
const certificates = cvSection('certification')?.entries;
const pdfHref = data && `/${data.pdf}`;

const years = (dates: string) => dates.replace(/\s+[-–]\s+/, ' to ');
// The CV sets titles in capitals for print; on the site they read in title case.
const SMALL = new Set(['and', 'in', 'of', 'for', 'the', 'to']);
const ACRONYMS = new Set(['AI', 'BI', 'ML', 'SQL']);
const titled = (title: string) =>
  title !== title.toUpperCase()
    ? title
    : title
        .split(' ')
        .map((word, i) => {
          if (ACRONYMS.has(word)) return word;
          const lower = word.toLowerCase();
          return i > 0 && SMALL.has(lower) ? lower : lower.charAt(0).toUpperCase() + lower.slice(1);
        })
        .join(' ');
// The CV gives countries as ISO codes.
const COUNTRIES: Record<string, string> = { VN: 'Vietnam', FR: 'France' };
const place = (org: string[]) => org.map((part) => COUNTRIES[part] ?? part).join(', ');
const month = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', {
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
---

<Base
  title="Work · Tung Anh Tran"
  description="Roles, education and certificates of Tung Anh Tran, data scientist."
>
  <header class="wrap page-head">
    <h1 class="page-title">Work</h1>
    <p class="page-lede">Roles, teams and what each one shipped, most recent first.</p>
  </header>

  <div class="wrap">
    <section class="ledger" aria-labelledby="roles">
      <h2 class="ledger-label" id="roles">Experience</h2>
      <div class="ledger-body">
        <ol class="timeline">
          {
            roles
              ? roles.map((role) => (
                  <li class="role">
                    <p class="role-years">{years(role.dates)}</p>
                    <h3 class="role-title">{titled(role.title)}</h3>
                    <p class="role-org">{place(role.org)}</p>
                    {role.lines.map((line) => (
                      <p class="prose">{line}</p>
                    ))}
                    {role.points.length > 0 && (
                      <ul>
                        {role.points.map((point) => (
                          <li>
                            {point.label && <strong>{point.label}:</strong>} {point.text}
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))
              : EXPERIENCE.map((role) => (
                  <li class="role role--placeholder">
                    <p class="role-years">
                      {role.start} to {role.end}
                      <Placeholder />
                    </p>
                    <h3 class="role-title">{role.title}</h3>
                    <p class="role-org">
                      {role.org}, {role.place}
                    </p>
                    <p class="prose">{role.summary}</p>
                    <ul>
                      {role.points.map((point) => (
                        <li>{point}</li>
                      ))}
                    </ul>
                  </li>
                ))
          }
        </ol>
      </div>
    </section>

    <section class="ledger" aria-labelledby="study">
      <h2 class="ledger-label" id="study">Education</h2>
      <div class="ledger-body">
        {
          study ? (
            <ol class="entries">
              {study.map((item) => (
                <li class="entry">
                  <div class="entry-head">
                    <h3 class="entry-title">{titled(item.title)}</h3>
                    <span class="entry-years">{years(item.dates)}</span>
                  </div>
                  {item.org.length > 0 && <p class="entry-org">{place(item.org)}</p>}
                  {item.lines.map((line) => (
                    <p class="entry-line">{line}</p>
                  ))}
                </li>
              ))}
            </ol>
          ) : (
            <dl class="facts">
              {EDUCATION.map((item) => (
                <div>
                  <dt>
                    {item.degree}, {item.school} <Placeholder />
                  </dt>
                  <dd>{item.years}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
    </section>

    {
      certificates && (
        <section class="ledger" aria-labelledby="certificates">
          <h2 class="ledger-label" id="certificates">Certificates</h2>
          <div class="ledger-body">
            <ol class="entries">
              {certificates.map((item) => (
                <li class="entry">
                  <div class="entry-head">
                    <h3 class="entry-title">{titled(item.title)}</h3>
                    <span class="entry-years">{years(item.dates)}</span>
                  </div>
                  {item.org.length > 0 && <p class="entry-org">{place(item.org)}</p>}
                  {item.lines.map((line) => (
                    <p class="entry-line">{line}</p>
                  ))}
                </li>
              ))}
            </ol>
          </div>
        </section>
      )
    }

    <section class="ledger" aria-labelledby="cv">
      <h2 class="ledger-label" id="cv">CV</h2>
      <div class="ledger-body">
        {
          data ? (
            <>
              <p class="prose">
                The full CV as a PDF{data.updated && `, last updated ${month(data.updated)}`}.
              </p>
              <p class="actions">
                <a class="button button--outline" href={pdfHref} download="Tung-Anh-Tran-CV.pdf">
                  Download CV (PDF)
                </a>
              </p>
            </>
          ) : (
            <>
              <p class="prose">A printable CV will be available here.</p>
              <p class="actions">
                <a class="button button--outline" aria-disabled="true">
                  Download CV (PDF)
                </a>
                <Placeholder />
              </p>
            </>
          )
        }
      </div>
    </section>
  </div>
</Base>
