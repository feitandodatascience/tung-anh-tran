---
import Signature from '../components/Signature.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Not found · Tung Anh Tran" description="This page does not exist.">
  <header class="wrap page-head not-found">
    <Signature swash />
    <h1 class="page-title">This page is not here</h1>
    <p class="page-lede">
      It may have moved when the site was reorganised. Start from the <a href="/">home page</a>
      or the <a href="/projects/">projects</a>.
    </p>
  </header>
  <div class="wrap page-gap"></div>
</Base>
