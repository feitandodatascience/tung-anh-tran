---
import Placeholder from '../components/Placeholder.astro';
import Rosette from '../components/Rosette.astro';
import Base from '../layouts/Base.astro';
import { POSITIONING, POST_PLACEHOLDERS, PROJECT_PLACEHOLDERS, TAGLINE } from '../data/site';
import { href, note, plainSummary, postPages, projectPages, publications } from '../lib/content';
import { findings, monthYear } from '../lib/format';

const work = projectPages();
const [featured] = work;
const more = work.slice(1, 3);
const projectSlots = PROJECT_PLACEHOLDERS.slice(0, Math.max(0, 2 - more.length));
const [paper] = publications();
const posts = postPages().slice(0, 3);
const postSlots = POST_PLACEHOLDERS.slice(0, Math.max(0, 3 - posts.length));
---

<Base title="Tung Anh Tran, data scientist" description={TAGLINE} deep>
  <section class="hero" aria-labelledby="hero-name">
    <Rosette class="hero-art" />
    <div class="wrap hero-inner">
      <h1 class="hero-name" id="hero-name">
        <span>Tung Anh</span>
        <span>Tran</span>
      </h1>
      <div class="hero-copy">
        <p class="hero-role">Data scientist</p>
        <p class="hero-lede">
          Machine learning models for classification and computer vision, on large and
          complex datasets.
        </p>
        <p class="actions">
          <a class="button button--light" href="/projects/">See the projects</a>
          <a class="button button--line" href="/contact/">Get in touch</a>
        </p>
      </div>
      {
        featured && (
          <p class="hero-latest">
            <span>Latest write-up</span>
            <a href={href(featured.entry)}>{featured.page.title}</a>
          </p>
        )
      }
    </div>
  </section>

  <div class="wrap">
    <section class="ledger" aria-labelledby="intro">
      <h2 class="ledger-label" id="intro">In short</h2>
      <div class="ledger-body">
        <p class="statement">{POSITIONING}</p>
        <p><a class="more" href="/about/">More about how I work</a></p>
      </div>
    </section>

    <section class="ledger" aria-labelledby="selected">
      <h2 class="ledger-label" id="selected">Selected work</h2>
      <div class="ledger-body">
        {
          featured ? (
            <article class="feature">
              <div class="feature-text">
                <p class="kind">{featured.page.eyebrow.split(' · ').join(', ')}</p>
                <h3 class="feature-title">
                  <a href={href(featured.entry)}>{featured.page.title}</a>
                </h3>
                <p set:html={plainSummary(featured.page.summary_html)} />
                <ul class="tags">
                  {featured.page.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
                <p>
                  <a class="more" href={href(featured.entry)}>
                    Read the write-up
                  </a>
                </p>
              </div>
              {featured.page.stats[0] && (
                <div class="plate">
                  <p class="plate-value">{featured.page.stats[0].value}</p>
                  <p class="plate-label">{featured.page.stats[0].label}</p>
                  <p class="plate-note">{featured.page.stats[0].note}</p>
                  <dl class="plate-more">
                    {featured.page.stats.slice(1).map((stat) => (
                      <div>
                        <dt>{stat.label}</dt>
                        <dd>{stat.value}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              )}
            </article>
          ) : (
            <p class="empty">No write-ups are published yet.</p>
          )
        }
        <ul class="rows">
          {
            more.map(({ entry, page }) => (
              <li class="row">
                <p class="kind">{page.eyebrow.split(' · ').join(', ')}</p>
                <h3 class="row-title">
                  <a href={href(entry)}>{page.title}</a>
                </h3>
                <p class="row-text" set:html={plainSummary(page.summary_html)} />
              </li>
            ))
          }
          {
            projectSlots.map((slot) => (
              <li class="row row--placeholder">
                <p class="kind">
                  {slot.kind} <Placeholder />
                </p>
                <h3 class="row-title">{slot.title}</h3>
                <p class="row-text">{slot.summary}</p>
              </li>
            ))
          }
        </ul>
        <p><a class="more" href="/projects/">All projects</a></p>
      </div>
    </section>

    {
      paper && (
        <section class="ledger" aria-labelledby="published">
          <h2 class="ledger-label" id="published">Published</h2>
          <div class="ledger-body">
            <article class="citation">
              <p class="kind">
                {paper.publication.venue}
                {paper.publication.issue && ` no. ${paper.publication.issue}`}, {monthYear(paper.date)}
              </p>
              <h3 class="citation-title" lang={paper.publication.language}>
                {paper.url ? <a href={paper.url}>{paper.title}</a> : paper.title}
              </h3>
              {paper.publication.title_en && (
                <p class="citation-en">{paper.publication.title_en}</p>
              )}
              <dl class="findings">
                {findings(note(paper)).slice(0, 3).map((f) => (
                  <div>
                    <dt>{f.value}</dt>
                    <dd>{f.name}</dd>
                  </div>
                ))}
              </dl>
              <p>
                <a class="more" href="/publications/">
                  Citation and details
                </a>
              </p>
            </article>
          </div>
        </section>
      )
    }

    <section class="ledger" aria-labelledby="notes">
      <h2 class="ledger-label" id="notes">From the blog</h2>
      <div class="ledger-body">
        <ul class="posts">
          {
            posts.map(({ entry, page }) => (
              <li class="post">
                <h3 class="post-title">
                  <a href={href(entry)}>{page.title}</a>
                </h3>
                <p class="post-text" set:html={plainSummary(page.summary_html)} />
                <p class="post-meta">{monthYear(entry.date)}</p>
              </li>
            ))
          }
          {
            postSlots.map((slot) => (
              <li class="post post--placeholder">
                <h3 class="post-title">{slot.title}</h3>
                <p class="post-text">{slot.summary}</p>
                <p class="post-meta">
                  {slot.month}, {slot.minutes} min read <Placeholder />
                </p>
              </li>
            ))
          }
        </ul>
        <p><a class="more" href="/blog/">All posts</a></p>
      </div>
    </section>
  </div>

  <section class="band" aria-labelledby="hire">
    <div class="wrap band-inner">
      <h2 id="hire" class="band-title">Have a dataset that needs a careful model?</h2>
      <p class="band-text">
        I'm open to data science, machine learning and analytics roles. Tell me about the
        data and the decision it should support.
      </p>
      <p class="actions">
        <a class="button button--light" href="/contact/">Get in touch</a>
      </p>
    </div>
  </section>
</Base>
