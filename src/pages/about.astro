---
import HexPortrait from '../components/HexPortrait.astro';
import Placeholder from '../components/Placeholder.astro';
import Base from '../layouts/Base.astro';
import { LANGUAGES, STACK } from '../data/site';
import { cvSection, href, projectPages, publications } from '../lib/content';

const languages = cvSection('language')?.items;
const insee = publications().find(({ publication }) => publication.issue === '2043');

// Lessons the approved DaT write-up records, restated as working habits.
const dat = projectPages().find(({ entry }) => entry.id === 'drivendata-dat-parkinsons-challenge');
const principles = [
  {
    title: 'Calibrate out of sample',
    text: 'A calibrator scored on its own training predictions looks better than it is. In the DaT challenge, the one that looked best in-sample did worse than no calibration once it was cross-validated.',
  },
  {
    title: 'Break results down by group',
    text: 'A pooled score can hide the groups that matter most. The same baseline looked well calibrated on all scans and was far off on its smallest acquisition family.',
  },
  {
    title: 'Stack models that fail differently',
    text: 'A weaker model that is wrong on different cases can add more than a stronger copy of what is already there. The tree model, weaker alone, carried a third of the final stack.',
  },
];
---

<Base
  title="About · Tung Anh Tran"
  description="Tung Anh Tran trained in France, co-authored an official INSEE study of 40 million salary records and built a hospital antimicrobial stewardship dashboard."
>
  <header class="wrap page-head about-head">
    <div>
      <h1 class="page-title">About</h1>
      <p class="page-lede">
        I'm Tung Anh Tran, a data scientist. I have worked on France's national statistics
        and on clinical research data from hospitals in Vietnam.
      </p>
    </div>
    <HexPortrait />
  </header>

  <div class="wrap">
    <section class="ledger" aria-labelledby="story">
      <h2 class="ledger-label" id="story">Background</h2>
      <div class="ledger-body">
        <div class="prose">
          <p>
            I trained in France, graduating top of my cohort in data science at Paris 1
            Panthéon-Sorbonne. At INSEE, the national statistics institute, I measured the
            public–private pay gap with Oaxaca–Blinder decompositions on a 40-million-record
            salary database. The work was published as {
              insee?.url ? <a href={insee.url}>Insee Première no. 2043</a> : 'Insee Première no. 2043'
            }, co-written with my former manager, Fanny Godet.
          </p>
          <p>
            At the Oxford University Clinical Research Unit in Vietnam, the data moved from
            salaries to hospital wards. I built the data platform behind a 30-page
            antimicrobial stewardship dashboard, bringing four independently developed
            components into one reporting system, ready to deploy across hospital sites.
          </p>
        </div>
      </div>
    </section>

    <section class="ledger" aria-labelledby="habits">
      <h2 class="ledger-label" id="habits">How I work</h2>
      <div class="ledger-body">
        <ul class="principles">
          {
            principles.map((p) => (
              <li class="principle">
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </li>
            ))
          }
        </ul>
        {
          dat && (
            <p class="evidence-link">
              <a class="more" href={href(dat.entry)}>
                The numbers behind these, in the DaT write-up
              </a>
            </p>
          )
        }
      </div>
    </section>

    <section class="ledger" aria-labelledby="kit">
      <h2 class="ledger-label" id="kit">My stack</h2>
      <div class="ledger-body toolkit">
        {
          STACK.map(({ group, items }) => (
            <div>
              <h3>{group}</h3>
              <ul>
                {items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="ledger" aria-labelledby="facts">
      <h2 class="ledger-label" id="facts">In brief</h2>
      <div class="ledger-body">
        <dl class="facts">
          <div>
            <dt>Based in</dt>
            <dd>Hanoi, Vietnam</dd>
          </div>
          {
            languages
              ? languages.map((lang) => (
                  <div>
                    <dt>{lang.label ?? 'Language'}</dt>
                    <dd>{lang.text}</dd>
                  </div>
                ))
              : LANGUAGES.map((lang) => (
                  <div>
                    <dt>Languages</dt>
                    <dd>
                      {lang.name} {lang.placeholder && <Placeholder />}
                    </dd>
                  </div>
                ))
          }
          <div>
            <dt>Experience and education</dt>
            <dd><a href="/work/">See Work</a></dd>
          </div>
        </dl>
      </div>
    </section>
  </div>
</Base>
